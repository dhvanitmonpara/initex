import { z } from "zod";
import { defineSchema } from "@/lib/define-zod-schema";
import { EmailSchema } from "@/shared/schemas/primitives";

export const LoginSchema = defineSchema("LoginSchema", {
	email: EmailSchema,
	password: z.string("Password is required"),
});

export const VerifyOtpSchema = z
	.object({
		otp: z.string("OTP is required"),
	})
	.openapi("verifyOtpSchema");

export const OtpSchema = z
	.object({
		email: EmailSchema,
	})
	.openapi("otpSchema");

export const RegistrationSchema = defineSchema("RegistrationSchema", {
	password: z
		.string("Password is required")
		.min(6, "Password must be at least 6 characters"),
}).openapi("RegistrationSchema");

export type LoginDto = z.infer<typeof LoginSchema>;

export const InitializeUserSchema = z
	.object({
		username: z
			.string("Username is required")
			.min(1, "Username must be at least 1 characters long"),
		email: EmailSchema,
	})
	.openapi("InitializeUserSchema");
